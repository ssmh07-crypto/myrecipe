{
  "name": "my-recipe-note-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@supabase/supabase-js": "^2.110.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.4",
    "expo-auth-session": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-print": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "EXPO_GO_LOCAL=1 expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable ../../functions/api/*.ts",
    "eas:init": "eas init",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production"
  },
  "private": true
}
